[Unit]
Description=Collect HomeHub read-only status snapshot
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/homehub/homehub_collector.py --output /var/lib/homehub/status.json
User=root
Group=root
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/homehub
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
UMask=0022
